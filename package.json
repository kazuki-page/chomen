{
  "name": "chomen",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply oyasan-app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply oyasan-app-db --remote",
    "db:seed": "node scripts/generate-seed.mjs > database/seed.generated.sql && wrangler d1 execute oyasan-app-db --local --file database/seed.generated.sql",
    "db:reset-auth": "wrangler d1 execute oyasan-app-db --local --command \"DELETE FROM session; DELETE FROM account; DELETE FROM memberships; DELETE FROM invitations; DELETE FROM user;\"",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.118.0"
  }
}
