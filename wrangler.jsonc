/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	/**
	 * アプリ名は「家主の帳面」だが、Worker と D1 の名前は `oyasan-app*` のまま。
	 * **改名しないこと。**
	 *   - Worker 名を変えると別の Worker が作られ、独自ドメインの張り直しが要る
	 *   - D1 名は作り直しに等しく、データの移行が発生する
	 * どちらも外部からは見えないので、揃える利益より事故のリスクが大きい。
	 */
	"name": "oyasan-app",
	"compatibility_date": "2026-08-01",
	"main": "./workers/app.ts",
	/**
	 * バージョンごとのプレビューURLは公開されるため無効にする。
	 * 同じ本番 D1 を参照するので、公開面は少ないほうがよい。
	 */
	"preview_urls": false,
	/**
	 * workers.dev のURLも塞ぐ。
	 * 同じ本番 D1 を参照するので、入口は独自ドメイン1つに絞る。
	 */
	"workers_dev": false,
	/**
	 * 独自ドメイン。DNS レコードと証明書は Cloudflare が自動で用意する。
	 */
	"routes": [
		{
			"pattern": "chomen.kazuki.page",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * D1 (SQLite)
	 * database_id は `npx wrangler d1 create oyasan-app-db` の出力を転記する。
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oyasan-app-db",
			"database_id": "060e222d-8aea-4159-8445-976afe88ab93",
			"migrations_dir": "database/migrations"
		}
	],
	/**
	 * デモかどうか。本番は必ず "false"。
	 * これ以外にデモと本番を分けるフラグを増やさないこと（増やすと分岐が散る）。
	 */
	"vars": {
		"DEMO_MODE": "false"
	},
	/**
	 * ==================================================================
	 * デモ環境
	 * ==================================================================
	 * **本番と同じコードを配る。コードを分岐させるのは DEMO_MODE だけ。**
	 * デプロイは必ず デモ → 本番 の順で行う（デモが本番の予行演習になる）。
	 *
	 *   npm run deploy:demo    # chomen-demo.kazuki.page
	 *   npm run deploy         # chomen.kazuki.page
	 *
	 * Worker も D1 も本番とは完全に別物で、本番データには一切触れない。
	 * デモには RESEND_API_KEY を登録しないこと（メールは送信されず警告ログのみになる）。
	 *
	 * 環境ごとに継承されない設定（name / routes / vars / d1_databases /
	 * triggers など）は、ここで全部書き直す必要がある。
	 */
	"env": {
		"demo": {
			"name": "chomen-demo",
			"preview_urls": false,
			"workers_dev": false,
			"routes": [
				{
					"pattern": "chomen-demo.kazuki.page",
					"custom_domain": true
				}
			],
			"observability": {
				"enabled": true
			},
			"upload_source_maps": true,
			"vars": {
				"DEMO_MODE": "true"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "chomen-demo-db",
					"database_id": "6af0db9d-4a85-4815-9676-77084edf874f",
					"migrations_dir": "database/migrations"
				}
			],
			/**
			 * 毎日 19:00 UTC（日本時間 翌 04:00）にデモのデータを初期状態へ戻す。
			 * 見学者が何をしても翌朝には元に戻る、という前提で書き込みを開放している。
			 * 実体は workers/app.ts の scheduled ハンドラ。
			 */
			"triggers": {
				"crons": [
					"0 19 * * *"
				]
			}
		}
	}
	/**
	 * R2（修繕写真・設備銘板写真・請求書の撮影）
	 *
	 * TODO: アカウントで R2 が未有効のためコメントアウトしている。
	 * ダッシュボードで R2 を有効化したのち、次を実行して以下を復帰させる:
	 *   npx wrangler r2 bucket create oyasan-app-attachments
	 *   npm run cf-typegen
	 *
	 * 写真機能は Phase 2 のため、MVP の実装は R2 なしで進められる。
	 */
	// "r2_buckets": [
	//  {
	//   "binding": "ATTACHMENTS",
	//   "bucket_name": "oyasan-app-attachments"
	//  }
	// ]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}