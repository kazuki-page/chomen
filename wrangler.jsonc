/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	/**
	 * アプリ名は「家主の帳面」だが、Worker と D1 の名前は `oyasan-app*` のまま。
	 * **改名しないこと。**
	 *   - Worker 名を変えると別の Worker が作られ、独自ドメインの張り直しが要る
	 *   - D1 名は作り直しに等しく、データの移行が発生する
	 * どちらも外部からは見えないので、揃える利益より事故のリスクが大きい。
	 */
	"name": "oyasan-app",
	"compatibility_date": "2026-08-01",
	"main": "./workers/app.ts",
	/**
	 * バージョンごとのプレビューURLは公開されるため無効にする。
	 * 同じ本番 D1 を参照するので、公開面は少ないほうがよい。
	 */
	"preview_urls": false,
	/**
	 * workers.dev のURLも塞ぐ。
	 * 同じ本番 D1 を参照するので、入口は独自ドメイン1つに絞る。
	 */
	"workers_dev": false,
	/**
	 * 独自ドメイン。DNS レコードと証明書は Cloudflare が自動で用意する。
	 */
	"routes": [
		{
			"pattern": "chomen.kazuki.page",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * D1 (SQLite)
	 * database_id は `npx wrangler d1 create oyasan-app-db` の出力を転記する。
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "oyasan-app-db",
			"database_id": "060e222d-8aea-4159-8445-976afe88ab93",
			"migrations_dir": "database/migrations"
		}
	]
	/**
	 * R2（修繕写真・設備銘板写真・請求書の撮影）
	 *
	 * TODO: アカウントで R2 が未有効のためコメントアウトしている。
	 * ダッシュボードで R2 を有効化したのち、次を実行して以下を復帰させる:
	 *   npx wrangler r2 bucket create oyasan-app-attachments
	 *   npm run cf-typegen
	 *
	 * 写真機能は Phase 2 のため、MVP の実装は R2 なしで進められる。
	 */
	// "r2_buckets": [
	//  {
	//   "binding": "ATTACHMENTS",
	//   "bucket_name": "oyasan-app-attachments"
	//  }
	// ]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}